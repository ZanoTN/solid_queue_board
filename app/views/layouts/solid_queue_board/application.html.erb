<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= sqb_t("title") %> · <%= SolidQueueBoard.app_title %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= sqb_inline_css %>
</head>
<body>
  <div class="sqb" id="sqb"
       data-poll-default="<%= SolidQueueBoard.default_poll_interval %>"
       data-partial-header="<%= SolidQueueBoard::ApplicationController::PARTIAL_HEADER %>"
       data-t-updated="<%= sqb_t("poll.updated") %>"
       data-t-next="<%= sqb_t("poll.next") %>"
       data-t-off="<%= sqb_t("poll.off") %>"
       data-t-loading="<%= sqb_t("poll.loading") %>"
       data-t-error="<%= sqb_t("poll.error") %>"
       data-t-every="<%= sqb_t("poll.every") %>"
       data-t-change="<%= sqb_t("poll.change") %>"
       data-t-theme="<%= sqb_t("theme.label") %>"
       data-t-theme-system="<%= sqb_t("theme.system") %>"
       data-t-theme-light="<%= sqb_t("theme.light") %>"
       data-t-theme-dark="<%= sqb_t("theme.dark") %>"
       data-poll-intervals="<%= SolidQueueBoard.poll_intervals.join(",") %>">
    <header class="bar">
      <div class="brand">
        <span class="logo"><%= sqb_t("title") %></span>
        <span class="env"><%= SolidQueueBoard.app_title %> · <%= Rails.env %></span>
      </div>
      <div class="tools">
        <button type="button" class="live" id="sqb-live" aria-describedby="sqb-live-status">
          <i aria-hidden="true"></i><span id="sqb-live-label"></span>
        </button>
        <span class="sr-only" id="sqb-live-status" aria-live="polite"></span>
        <button type="button" class="bar-icon" id="sqb-theme"></button>
        <% if SolidQueueBoard.back_url %>
          <%= link_to sqb_t("back"), SolidQueueBoard.back_url, class: "bar-link" %>
        <% end %>
      </div>
    </header>

    <div id="sqb-region">
      <%= render "solid_queue_board/shared/nav" %>
      <%= render "solid_queue_board/shared/flash" %>
      <main class="panel"><%= yield %></main>
    </div>
  </div>
  <%= sqb_inline_js %>
</body>
</html>
