<div id="sqb-toolbar"><%= render "toolbar" %></div>

<div class="tbl-wrap">
  <table class="with-details jobs">
    <thead>
      <tr>
        <th><%= sqb_t("jobs.columns.status") %></th>
        <%= sqb_sort_header sqb_t("jobs.columns.job"), "class_name" %>
        <%= sqb_sort_header sqb_t("jobs.columns.queue"), "queue_name" %>
        <%= sqb_sort_header sqb_t("jobs.columns.when"), @query.time_attribute %>
        <th><span class="sr-only"><%= sqb_t("jobs.columns.actions") %></span></th>
      </tr>
    </thead>
    <tbody id="sqb-rows">
      <% @query.rows.each do |job| %>
        <%= render "row", job: job %>
      <% end %>
      <%= render "empty" if @query.rows.empty? %>
    </tbody>
  </table>
</div>

<div id="sqb-pager"><%= render "pager" %></div>
