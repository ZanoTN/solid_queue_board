<% if @query.prev_page? || @query.next_page? %>
  <nav class="pager" aria-label="<%= sqb_t("jobs.pages") %>">
    <% if @query.prev_page? %>
      <%= link_to sqb_t("jobs.prev"), jobs_path(@query.url_params(page: @query.page - 1)), class: "btn" %>
    <% end %>
    <span class="muted"><%= sqb_t("jobs.page", page: @query.page) %></span>
    <% if @query.next_page? %>
      <%= link_to sqb_t("jobs.next"), jobs_path(@query.url_params(page: @query.page + 1)), class: "btn" %>
    <% end %>
  </nav>
<% end %>
